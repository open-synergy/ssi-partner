<odoo>
    <!-- insurance_product_coverage — all users read-only -->
    <record id="insurance_product_coverage_all_access" model="ir.model.access">
        <field name="name">insurance_product_coverage - all</field>
        <field name="model_id" ref="model_insurance_product_coverage" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- insurance_product_coverage — configurator full access -->
    <record id="insurance_product_coverage_user_access" model="ir.model.access">
        <field name="name">insurance_product_coverage - user</field>
        <field name="model_id" ref="model_insurance_product_coverage" />
        <field name="group_id" ref="insurance_product_coverage_group" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
