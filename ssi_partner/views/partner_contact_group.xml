<odoo>
    <record id="partner_contact_group_view_search" model="ir.ui.view">
        <field name="name">partner_contact_group - search</field>
        <field name="model">partner_contact_group</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="partner_contact_group_view_list" model="ir.ui.view">
        <field name="name">partner_contact_group - list</field>
        <field name="model">partner_contact_group</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="commercial_contact_id" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="partner_contact_group_view_form" model="ir.ui.view">
        <field name="name">partner_contact_group - form</field>
        <field name="model">partner_contact_group</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="contact" string="Contacts">
                        <field name="allowed_contact_ids" invisible="1" />
                        <group name="contact_group_1">
                            <field name="commercial_contact_id" />
                            <field
                                name="contact_ids"
                                widget="many2many_tags"
                                domain="[('id', 'in', allowed_contact_ids)]"
                            />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="partner_contact_group_action" model="ir.actions.act_window">
        <field name="name">Contact Groups</field>
        <field name="res_model">partner_contact_group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="partner_contact_group_menu"
        parent="menu_partner_configuration"
        action="partner_contact_group_action"
        sequence="60"
    />
</odoo>
