<odoo>
    <!-- res.partner.title is intentionally NOT mixin.master_data (see
         models/res_partner_title.py docstring), so its views are plain
         records instead of inheriting the mixin templates. -->
    <record id="res_partner_title_view_search" model="ir.ui.view">
        <field name="name">res.partner.title - search</field>
        <field name="model">res.partner.title</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="shortcut" />
                <filter
                    name="dom_inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="res_partner_title_view_list" model="ir.ui.view">
        <field name="name">res.partner.title - list</field>
        <field name="model">res.partner.title</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="shortcut" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="res_partner_title_view_form" model="ir.ui.view">
        <field name="name">res.partner.title - form</field>
        <field name="model">res.partner.title</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group name="group_1" colspan="4" col="2">
                        <field name="name" />
                        <field name="shortcut" />
                        <field name="sequence" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_title_action" model="ir.actions.act_window">
        <field name="name">Contact Titles</field>
        <field name="res_model">res.partner.title</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="res_partner_title_menu"
        parent="menu_partner_configuration"
        action="res_partner_title_action"
        sequence="50"
    />
</odoo>
