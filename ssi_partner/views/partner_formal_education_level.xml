<odoo>
    <record id="partner_formal_education_level_view_search" model="ir.ui.view">
        <field name="name">partner_formal_education_level - search</field>
        <field name="model">partner_formal_education_level</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="partner_formal_education_level_view_list" model="ir.ui.view">
        <field name="name">partner_formal_education_level - list</field>
        <field name="model">partner_formal_education_level</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <field name="code" position="before">
                    <field name="sequence" widget="handle" />
                </field>
            </data>
        </field>
    </record>

    <record id="partner_formal_education_level_view_form" model="ir.ui.view">
        <field name="name">partner_formal_education_level - form</field>
        <field name="model">partner_formal_education_level</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <group name="group_1" position="inside">
                    <field name="sequence" />
                </group>
            </data>
        </field>
    </record>

    <record id="partner_formal_education_level_action" model="ir.actions.act_window">
        <field name="name">Formal Education Levels</field>
        <field name="res_model">partner_formal_education_level</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="partner_formal_education_level_menu"
        parent="menu_partner_configuration"
        action="partner_formal_education_level_action"
        sequence="90"
    />
</odoo>
