<odoo>
    <record id="partner_field_of_study_view_search" model="ir.ui.view">
        <field name="name">partner_field_of_study - search</field>
        <field name="model">partner_field_of_study</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="partner_field_of_study_view_list" model="ir.ui.view">
        <field name="name">partner_field_of_study - list</field>
        <field name="model">partner_field_of_study</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <field name="code" position="after">
                    <field name="parent_id" />
                </field>
            </data>
        </field>
    </record>

    <record id="partner_field_of_study_view_form" model="ir.ui.view">
        <field name="name">partner_field_of_study - form</field>
        <field name="model">partner_field_of_study</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <group name="group_1" position="inside">
                    <field name="parent_id" />
                </group>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="field_of_study_children" string="Specializations">
                        <field name="child_ids">
                            <list>
                                <field name="code" />
                                <field name="name" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="partner_field_of_study_action" model="ir.actions.act_window">
        <field name="name">Fields of Study</field>
        <field name="res_model">partner_field_of_study</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="partner_field_of_study_menu"
        parent="menu_partner_configuration"
        action="partner_field_of_study_action"
        sequence="80"
    />
</odoo>
