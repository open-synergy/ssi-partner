<odoo>
    <record id="partner_academic_view_form" model="ir.ui.view">
        <field name="name">partner_academic - form</field>
        <field name="model">partner_academic</field>
        <field name="inherit_id" ref="mixin_partner_experience_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <group name="group_left" position="inside">
                    <field name="education_level_id" />
                    <field name="field_of_study_id" />
                    <field name="diploma" />
                </group>
                <group name="group_right" position="inside">
                    <field name="gpa" />
                </group>
                <xpath expr="//page[@name='note']" position="before">
                    <page name="activities" string="Activities">
                        <field name="activities" colspan="4" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
